// Prisma schema for StockSense v2.0
// Inventory Management System + Customer E-commerce Store (Blinkit-style Warehouse)
// All stock-changing operations MUST use transactions (stock_levels + stock_moves atomically)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String    @map("password_hash")
  role         Role      @default(MANAGER)
  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  addresses         Address[]
  customerOrders    CustomerOrder[]
  receipts          Receipt[]
  deliveryOrders    DeliveryOrder[]
  internalTransfers InternalTransfer[]
  stockAdjustments  StockAdjustment[]
  stockMoves        StockMove[]
  countTasks        CountTask[]
  approvedCounts    CountTask[] @relation("CountApprover")

  @@map("users")
}

enum Role {
  MANAGER
  STAFF
  CUSTOMER
}

// ─── Customer Addresses ──────────────────────────────────────────────────────

model Address {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ─── Locations / Warehouses ──────────────────────────────────────────────────

model Location {
  id        String   @id @default(cuid())
  name      String
  code        String      @unique
  parentId    String?     @map("parent_id")
  storageType StorageType @default(AMBIENT) @map("storage_type")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[] @relation("LocationHierarchy")

  stockLevels       StockLevel[]
  receipts          Receipt[]
  deliveryOrders    DeliveryOrder[]
  transfersFrom     InternalTransfer[] @relation("TransferSource")
  transfersTo       InternalTransfer[] @relation("TransferDest")
  stockAdjustments  StockAdjustment[]
  stockMoves        StockMove[]
  batches           StockBatch[]
  countTasks        CountTask[]

  @@map("locations")
}

enum StorageType {
  AMBIENT
  CHILLED
  FROZEN
  FRESH
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id       String  @id @default(cuid())
  name     String  @unique
  parentId String? @map("parent_id")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id                String   @id @default(cuid())
  name              String
  sku               String   @unique
  categoryId        String?  @map("category_id")
  uom               String   @default("pcs") // Unit of Measure
  reorderPoint      Decimal  @default(0) @map("reorder_point") @db.Decimal(12, 3)
  price             Decimal  @default(0) @db.Decimal(10, 2)
  costPrice         Decimal? @map("cost_price") @db.Decimal(10, 2)
  barcode           String?  @unique
  storageType       StorageType @default(AMBIENT) @map("storage_type")
  leadTimeDays      Int      @default(5) @map("lead_time_days")
  dailyDemand       Decimal  @default(0) @map("daily_demand") @db.Decimal(12, 3)
  imageUrl          String?  @map("image_url")
  isVisibleOnStore  Boolean  @default(true) @map("is_visible_on_store")
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  category           Category?           @relation(fields: [categoryId], references: [id])
  stockLevels        StockLevel[]
  receiptLines       ReceiptLine[]
  batches            StockBatch[]
  countTasks         CountTask[]
  deliveryLines      DeliveryLine[]
  transferLines      TransferLine[]
  stockAdjustments   StockAdjustment[]
  stockMoves         StockMove[]
  customerOrderLines CustomerOrderLine[]

  @@map("products")
}

// ─── Stock Levels ────────────────────────────────────────────────────────────

model StockLevel {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  locationId String   @map("location_id")
  quantity   Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt  DateTime @updatedAt @map("updated_at")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("stock_levels")
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

model Supplier {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  address String?

  receipts Receipt[]

  @@map("suppliers")
}

// ─── Receipts (Incoming Stock) ───────────────────────────────────────────────

model Receipt {
  id          String         @id @default(cuid())
  reference   String         @unique @default(cuid())
  supplierId  String?        @map("supplier_id")
  locationId  String         @map("location_id")
  status      DocumentStatus @default(DRAFT)
  notes       String?
  createdBy   String         @map("created_by")
  validatedAt DateTime?      @map("validated_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  supplier Supplier?     @relation(fields: [supplierId], references: [id])
  location Location      @relation(fields: [locationId], references: [id])
  creator  User          @relation(fields: [createdBy], references: [id])
  lines    ReceiptLine[]

  @@map("receipts")
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String  @map("receipt_id")
  productId String  @map("product_id")
  quantity  Decimal @db.Decimal(12, 3)
  uom       String  @default("pcs")

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("receipt_lines")
}

// ─── Customer Orders (Storefront) ────────────────────────────────────────────

model CustomerOrder {
  id              String              @id @default(cuid())
  orderNumber     String              @unique @map("order_number")
  customerId      String              @map("customer_id")
  status          CustomerOrderStatus @default(PLACED)
  totalAmount     Decimal             @map("total_amount") @db.Decimal(10, 2)
  paymentMethod   String              @default("COD") @map("payment_method")
  shippingAddress Json                @map("shipping_address")
  customerPhone   String?             @map("customer_phone")
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  customer      User                @relation(fields: [customerId], references: [id])
  lines         CustomerOrderLine[]
  deliveryOrder DeliveryOrder?

  @@map("customer_orders")
}

model CustomerOrderLine {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@map("customer_order_lines")
}

enum CustomerOrderStatus {
  PLACED
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

// ─── Delivery Orders (Outgoing Stock) ────────────────────────────────────────

model DeliveryOrder {
  id              String         @id @default(cuid())
  reference       String         @unique @default(cuid())
  customerName    String         @map("customer_name")
  locationId      String         @map("location_id")
  status          DocumentStatus @default(DRAFT)
  source          DeliverySource @default(MANUAL)
  customerOrderId String?        @unique @map("customer_order_id")
  notes           String?
  createdBy       String         @map("created_by")
  validatedAt     DateTime?      @map("validated_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  location      Location       @relation(fields: [locationId], references: [id])
  creator       User           @relation(fields: [createdBy], references: [id])
  customerOrder CustomerOrder? @relation(fields: [customerOrderId], references: [id])
  lines         DeliveryLine[]

  @@map("delivery_orders")
}

enum DeliverySource {
  MANUAL
  CUSTOMER_ORDER
}

model DeliveryLine {
  id         String  @id @default(cuid())
  deliveryId String  @map("delivery_id")
  productId  String  @map("product_id")
  quantity   Decimal @db.Decimal(12, 3)

  delivery DeliveryOrder @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@map("delivery_lines")
}

// ─── Internal Transfers ──────────────────────────────────────────────────────

model InternalTransfer {
  id               String         @id @default(cuid())
  reference        String         @unique @default(cuid())
  sourceLocationId String         @map("source_location_id")
  destLocationId   String         @map("dest_location_id")
  status           DocumentStatus @default(DRAFT)
  createdBy        String         @map("created_by")
  validatedAt      DateTime?      @map("validated_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  sourceLocation Location       @relation("TransferSource", fields: [sourceLocationId], references: [id])
  destLocation   Location       @relation("TransferDest", fields: [destLocationId], references: [id])
  creator        User           @relation(fields: [createdBy], references: [id])
  lines          TransferLine[]

  @@map("internal_transfers")
}

model TransferLine {
  id         String  @id @default(cuid())
  transferId String  @map("transfer_id")
  productId  String  @map("product_id")
  quantity   Decimal @db.Decimal(12, 3)

  transfer InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product          @relation(fields: [productId], references: [id])

  @@map("transfer_lines")
}

// ─── Stock Adjustments ───────────────────────────────────────────────────────

model StockAdjustment {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  locationId  String   @map("location_id")
  countedQty  Decimal  @map("counted_qty") @db.Decimal(12, 3)
  previousQty Decimal  @map("previous_qty") @db.Decimal(12, 3)
  difference  Decimal  @db.Decimal(12, 3)
  reason      String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@map("stock_adjustments")
}

// ─── Stock Moves (Ledger) ────────────────────────────────────────────────────

model StockMove {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  locationId     String   @map("location_id")
  quantityChange Decimal  @map("quantity_change") @db.Decimal(12, 3)
  moveType       MoveType @map("move_type")
  referenceId    String   @map("reference_id")
  referenceType  String   @map("reference_type")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@index([productId])
  @@index([locationId])
  @@index([moveType])
  @@index([createdAt])
  @@map("stock_moves")
}

// ─── Batches (FEFO) ──────────────────────────────────────────────────────────

model StockBatch {
  id         String    @id @default(cuid())
  productId  String    @map("product_id")
  locationId String    @map("location_id")
  lotCode    String    @map("lot_code")
  quantity   Decimal   @default(0) @db.Decimal(12, 3)
  expiresAt  DateTime  @map("expires_at")
  status     BatchStatus @default(AVAILABLE)
  receivedAt DateTime  @default(now()) @map("received_at")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId, lotCode])
  @@index([expiresAt])
  @@map("stock_batches")
}

enum BatchStatus {
  AVAILABLE
  QUARANTINE
  EXPIRED
}

// ─── Cycle counts ────────────────────────────────────────────────────────────

model CountTask {
  id           String      @id @default(cuid())
  reference    String      @unique
  productId    String      @map("product_id")
  locationId   String      @map("location_id")
  status       CountStatus @default(OPEN)
  blind        Boolean     @default(true)
  systemQty    Decimal     @map("system_qty") @db.Decimal(12, 3)
  countedQty   Decimal?    @map("counted_qty") @db.Decimal(12, 3)
  reason       String?
  priority     String      @default("B")
  assignedTo   String?     @map("assigned_to")
  approvedBy   String?     @map("approved_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  submittedAt  DateTime?   @map("submitted_at")
  postedAt     DateTime?   @map("posted_at")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  assignee User?    @relation(fields: [assignedTo], references: [id])
  approver User?    @relation("CountApprover", fields: [approvedBy], references: [id])

  @@map("count_tasks")
}

enum CountStatus {
  OPEN
  SUBMITTED
  POSTED
  REJECTED
}

enum MoveType {
  RECEIPT
  DELIVERY
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum DocumentStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}
